{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "bash": {
      "railway *": "deny",
      "*railway *": "deny",
      "git push *": "deny",
      "*git push *": "deny"
    },
    "railway*": "deny"
  },
  "provider": {
    "openrouter": {
      "models": {
        "openai/gpt-5.6-sol": {
          "options": {
            "provider": {
              "only": [
                "openai"
              ],
              "allow_fallbacks": false
            }
          }
        }
      }
    }
  }
}
